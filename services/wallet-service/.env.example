PROJECT_NAME="Tài Xỉu Wallet Service"
API_V1_STR="/api/v1"

# Shared JWT secret with Auth Service to authenticate players
SECRET_KEY="taixiu_super_secure_jwt_secret_key_change_me_in_prod_2026"
ALGORITHM="HS256"

# Internal Service-to-Service API Key for Game Engine to hold/settle bets
INTERNAL_API_KEY="internal_service_secret_taixiu_game_engine_key_2026"

# Database connection string
DATABASE_URL="sqlite+aiosqlite:///./wallet.db"
# PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://taixiu_admin:taixiu_secret_password@wallet-db:5432/taixiu_wallet"

# Default starting bonus chips for newly created wallets (e.g. 100,000 VND / Chips)
INITIAL_WELCOME_BONUS=100000.0

BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

